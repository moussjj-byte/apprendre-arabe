<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apprendre l'Arabe</title>

<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

<style>
:root {
  --gold:#C9A84C;
  --gold2:#e8c878;
  --dark:#0d0900;
  --cream:#fdf6e3;
  --bg:#0a0700;
  --card:#130e04;
  --card2:#1a1408;
  --border:#2e2208;
}

* {
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body {
  font-family:'Lato',sans-serif;
  background:var(--bg);
  color:var(--cream);
  min-height:100vh;
  overflow-x:hidden;
}

body::before {
  content:'';
  position:fixed;
  inset:0;
  background:
    radial-gradient(ellipse at 15% 10%,rgba(201,168,76,0.07) 0%,transparent 45%),
    radial-gradient(ellipse at 85% 90%,rgba(26,74,58,0.08) 0%,transparent 45%);
  pointer-events:none;
  z-index:0;
}

.wrap {
  max-width:960px;
  margin:0 auto;
  padding:16px 16px 60px;
  position:relative;
  z-index:1;
}

header {
  text-align:center;
  padding:36px 20px 28px;
  border-bottom:1px solid var(--border);
  margin-bottom:26px;
}

.hdr-ar {
  font-family:'Amiri',serif;
  font-size:2.6rem;
  color:var(--gold);
  direction:rtl;
  line-height:1.3;
  text-shadow:0 0 50px rgba(201,168,76,0.25);
}

.hdr-fr {
  font-size:0.8rem;
  color:rgba(253,246,227,0.45);
  letter-spacing:0.22em;
  text-transform:uppercase;
  margin-top:6px;
}

.nav {
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  justify-content:center;
  margin-bottom:26px;
}

.nav-btn {
  background:var(--card);
  border:1px solid var(--border);
  color:rgba(253,246,227,0.55);
  padding:8px 15px;
  border-radius:4px;
  cursor:pointer;
  font-family:'Lato',sans-serif;
  font-size:0.8rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  transition:all 0.2s;
}

.nav-btn:hover {
  border-color:var(--gold);
  color:var(--gold);
}

.nav-btn.active {
  background:var(--gold);
  border-color:var(--gold);
  color:var(--dark);
  font-weight:700;
}

.section {
  display:none;
  animation:fadeUp 0.35s ease;
}

.section.active {
  display:block;
}

@keyframes fadeUp {
  from {
    opacity:0;
    transform:translateY(12px);
  }
  to {
    opacity:1;
    transform:translateY(0);
  }
}

.sec-title {
  font-family:'Playfair Display',serif;
  font-size:1.3rem;
  color:var(--gold);
  margin-bottom:18px;
  padding-bottom:10px;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  gap:10px;
}

.sec-title::before {
  content:'';
  display:inline-block;
  width:3px;
  height:1.2rem;
  background:var(--gold);
  border-radius:2px;
  flex-shrink:0;
}

.cats {
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-bottom:18px;
}

.cat-pill {
  background:var(--card);
  border:1px solid var(--border);
  color:rgba(253,246,227,0.55);
  padding:5px 13px;
  border-radius:20px;
  cursor:pointer;
  font-size:0.78rem;
  transition:all 0.2s;
}

.cat-pill.active,
.cat-pill:hover {
  border-color:var(--gold);
  color:var(--gold);
  background:rgba(201,168,76,0.1);
}

.vocab-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:12px;
}

.v-card {
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:8px;
  padding:18px 14px;
  text-align:center;
  transition:all 0.22s;
  cursor:pointer;
}

.v-card:hover {
  border-color:rgba(201,168,76,0.5);
  transform:translateY(-2px);
  box-shadow:0 6px 20px rgba(201,168,76,0.12);
}

.v-card.speaking {
  border-color:var(--gold);
  background:rgba(201,168,76,0.08);
}

.v-ar {
  font-family:'Amiri',serif;
  font-size:1.9rem;
  color:var(--gold);
  direction:rtl;
  display:block;
  margin-bottom:8px;
  line-height:1.4;
}

.v-fr {
  font-size:0.82rem;
  color:rgba(253,246,227,0.65);
  text-transform:uppercase;
  font-weight:700;
  letter-spacing:0.04em;
}

.v-tr {
  font-size:0.72rem;
  color:rgba(201,168,76,0.55);
  margin-top:3px;
  font-style:italic;
}

.speak-btn {
  background:none;
  border:1px solid rgba(201,168,76,0.3);
  color:var(--gold);
  border-radius:20px;
  padding:4px 12px;
  font-size:0.7rem;
  cursor:pointer;
  margin-top:8px;
  transition:all 0.2s;
  display:inline-block;
}

.speak-btn:hover,
.speak-btn.playing {
  background:rgba(201,168,76,0.15);
}

.fc-wrap {
  max-width:460px;
  margin:0 auto 24px;
  perspective:1000px;
  cursor:pointer;
}

.flashcard {
  width:100%;
  height:210px;
  position:relative;
  transform-style:preserve-3d;
  transition:transform 0.55s cubic-bezier(0.4,0,0.2,1);
  border-radius:10px;
}

.flashcard.flipped {
  transform:rotateY(180deg);
}

.fc-face {
  position:absolute;
  inset:0;
  backface-visibility:hidden;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:28px;
  border:1px solid var(--border);
  border-radius:10px;
}

.fc-front {
  background:linear-gradient(135deg,#1a1206,#231800);
}

.fc-back {
  background:linear-gradient(135deg,#0b1a10,#122018);
  transform:rotateY(180deg);
  border-color:rgba(45,90,39,0.5);
}

.fc-lbl {
  font-size:0.68rem;
  text-transform:uppercase;
  letter-spacing:0.14em;
  color:rgba(253,246,227,0.28);
  margin-bottom:14px;
}

.fc-ar {
  font-family:'Amiri',serif;
  font-size:3.2rem;
  color:var(--gold);
  direction:rtl;
  text-shadow:0 0 24px rgba(201,168,76,0.35);
}

.fc-fr {
  font-size:1.4rem;
  color:#7dd874;
  font-family:'Playfair Display',serif;
}

.fc-hint {
  font-size:0.72rem;
  color:rgba(253,246,227,0.25);
  margin-top:8px;
}

.fc-nav {
  display:flex;
  gap:10px;
  justify-content:center;
  align-items:center;
  margin-top:12px;
}

.btn-ol {
  background:transparent;
  border:1px solid var(--border);
  color:var(--cream);
  padding:9px 18px;
  border-radius:5px;
  cursor:pointer;
  font-size:0.82rem;
  font-family:'Lato',sans-serif;
  transition:all 0.2s;
}

.btn-ol:hover {
  border-color:var(--gold);
  color:var(--gold);
}

.fc-cnt {
  color:rgba(253,246,227,0.35);
  font-size:0.82rem;
  min-width:55px;
  text-align:center;
}

.fc-speak {
  background:rgba(201,168,76,0.1);
  border:1px solid rgba(201,168,76,0.3);
  color:var(--gold);
  padding:8px 16px;
  border-radius:5px;
  cursor:pointer;
  font-size:0.82rem;
  font-family:'Lato',sans-serif;
  transition:all 0.2s;
}

.fc-speak:hover,
.fc-speak.playing {
  background:rgba(201,168,76,0.2);
}

.quiz-box {
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:12px;
  padding:36px 28px;
  text-align:center;
  max-width:580px;
  margin:0 auto;
}

.q-score {
  font-size:0.85rem;
  color:rgba(253,246,227,0.45);
  margin-bottom:20px;
}

.q-num {
  color:var(--gold);
  font-weight:700;
  font-size:1.05rem;
}

.q-word {
  font-family:'Amiri',serif;
  font-size:3.8rem;
  color:var(--gold);
  direction:rtl;
  min-height:76px;
  text-shadow:0 0 28px rgba(201,168,76,0.35);
  margin-bottom:6px;
  cursor:pointer;
}

.q-word:active {
  opacity:0.7;
}

.q-hint {
  font-size:0.75rem;
  color:rgba(253,246,227,0.35);
  text-transform:uppercase;
  letter-spacing:0.1em;
  margin-bottom:24px;
}

.q-opts {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:18px;
}

.q-opt {
  background:rgba(253,246,227,0.04);
  border:1px solid var(--border);
  color:var(--cream);
  padding:13px 10px;
  border-radius:6px;
  cursor:pointer;
  font-size:0.9rem;
  font-family:'Lato',sans-serif;
  transition:all 0.18s;
  line-height:1.3;
}

.q-opt:hover:not(:disabled) {
  border-color:var(--gold);
  background:rgba(201,168,76,0.1);
}

.q-opt.correct {
  background:rgba(45,90,39,0.4);
  border-color:#4a9e42;
  color:#7dd874;
}

.q-opt.wrong {
  background:rgba(150,30,30,0.4);
  border-color:#9e4242;
  color:#e87a7a;
}

.q-opt:disabled {
  cursor:default;
}

.q-fb {
  font-size:0.95rem;
  margin:14px 0;
  min-height:22px;
  font-weight:700;
  letter-spacing:0.04em;
}

.q-fb.ok {
  color:#7dd874;
}

.q-fb.err {
  color:#e87a7a;
}

.btn {
  background:var(--gold);
  color:var(--dark);
  border:none;
  padding:11px 26px;
  border-radius:5px;
  cursor:pointer;
  font-weight:700;
  font-family:'Lato',sans-serif;
  font-size:0.88rem;
  letter-spacing:0.05em;
  text-transform:uppercase;
  transition:all 0.2s;
}

.btn:hover {
  background:var(--gold2);
  transform:translateY(-1px);
}

.tip {
  background:rgba(201,168,76,0.07);
  border:1px solid rgba(201,168,76,0.2);
  border-radius:7px;
  padding:13px 17px;
  margin-bottom:20px;
  font-size:0.82rem;
  color:rgba(253,246,227,0.65);
  line-height:1.65;
}

.tip strong {
  color:var(--gold);
}

.sourate-list {
  display:flex;
  flex-direction:column;
  gap:20px;
}

.sourate-card {
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:10px;
  overflow:hidden;
  transition:border-color 0.2s;
}

.sourate-card:hover {
  border-color:rgba(201,168,76,0.4);
}

.sourate-header {
  display:flex;
  align-items:center;
  gap:16px;
  padding:18px 20px;
  cursor:pointer;
  background:linear-gradient(90deg,rgba(201,168,76,0.07),transparent);
}

.sourate-num {
  width:40px;
  height:40px;
  border-radius:50%;
  border:1px solid var(--gold);
  color:var(--gold);
  font-family:'Amiri',serif;
  font-size:1.1rem;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.sourate-meta {
  flex:1;
}

.sourate-name-ar {
  font-family:'Amiri',serif;
  font-size:1.5rem;
  color:var(--gold);
  direction:rtl;
  display:block;
}

.sourate-name-fr {
  font-size:0.78rem;
  color:rgba(253,246,227,0.5);
  margin-top:2px;
  text-transform:uppercase;
  letter-spacing:0.08em;
}

.sourate-info {
  font-size:0.72rem;
  color:rgba(253,246,227,0.3);
  margin-top:2px;
}

.sourate-toggle {
  color:rgba(253,246,227,0.3);
  font-size:1.1rem;
  transition:transform 0.3s;
}

.sourate-card.open .sourate-toggle {
  transform:rotate(180deg);
}

.sourate-body {
  display:none;
  padding:0 20px 20px;
}

.sourate-card.open .sourate-body {
  display:block;
}

.audio-bar {
  display:flex;
  align-items:center;
  gap:10px;
  background:rgba(201,168,76,0.08);
  border:1px solid rgba(201,168,76,0.2);
  border-radius:8px;
  padding:12px 16px;
  margin-bottom:16px;
}

.audio-play {
  width:38px;
  height:38px;
  border-radius:50%;
  background:var(--gold);
  border:none;
  color:var(--dark);
  font-size:1rem;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  transition:all 0.2s;
}

.audio-play:hover {
  background:var(--gold2);
}

.audio-info {
  flex:1;
}

.audio-title {
  font-size:0.82rem;
  color:var(--gold);
  font-weight:700;
}

.audio-sub {
  font-size:0.7rem;
  color:rgba(253,246,227,0.4);
  margin-top:2px;
}

.audio-progress {
  width:100%;
  height:3px;
  background:var(--border);
  border-radius:3px;
  margin-top:6px;
  overflow:hidden;
}

.audio-fill {
  height:100%;
  background:var(--gold);
  border-radius:3px;
  width:0%;
  transition:width 0.3s linear;
}

.verse-block {
  margin-bottom:22px;
  padding-bottom:20px;
  border-bottom:1px solid var(--border);
}

.verse-block:last-child {
  border-bottom:none;
  margin-bottom:0;
  padding-bottom:0;
}

.verse-ar {
  font-family:'Amiri',serif;
  font-size:1.7rem;
  color:var(--cream);
  direction:rtl;
  line-height:1.9;
  text-align:right;
  margin-bottom:8px;
  background:rgba(201,168,76,0.04);
  border-right:3px solid var(--gold);
  padding:10px 14px;
  border-radius:4px;
}

.verse-ar .vnum {
  font-size:0.85rem;
  color:var(--gold);
  vertical-align:middle;
  margin-left:6px;
}

.verse-tr {
  font-size:0.78rem;
  color:rgba(201,168,76,0.6);
  font-style:italic;
  margin-bottom:4px;
}

.verse-fr {
  font-size:0.92rem;
  color:rgba(253,246,227,0.75);
  line-height:1.6;
  margin-bottom:12px;
}

.verse-speak {
  background:rgba(201,168,76,0.08);
  border:1px solid rgba(201,168,76,0.25);
  color:var(--gold);
  padding:5px 12px;
  border-radius:4px;
  cursor:pointer;
  font-size:0.72rem;
  margin-bottom:10px;
  display:inline-block;
  transition:all 0.2s;
}

.verse-speak:hover,
.verse-speak.playing {
  background:rgba(201,168,76,0.2);
  border-color:var(--gold);
}

.word-breakdown {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  direction:rtl;
}

.word-chip {
  background:rgba(201,168,76,0.08);
  border:1px solid rgba(201,168,76,0.2);
  border-radius:5px;
  padding:6px 10px;
  cursor:pointer;
  transition:all 0.18s;
}

.word-chip:hover,
.word-chip.playing {
  background:rgba(201,168,76,0.2);
  border-color:var(--gold);
}

.word-chip .w-ar {
  font-family:'Amiri',serif;
  font-size:1.1rem;
  color:var(--gold);
  display:block;
}

.word-chip .w-fr {
  font-size:0.68rem;
  color:rgba(253,246,227,0.5);
  display:block;
  margin-top:2px;
  direction:ltr;
}

.breakdown-lbl {
  font-size:0.7rem;
  text-transform:uppercase;
  letter-spacing:0.12em;
  color:rgba(253,246,227,0.3);
  margin-bottom:8px;
  direction:ltr;
}

.vocab-coran {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(155px,1fr));
  gap:10px;
  margin-top:14px;
}

.vc-card {
  background:rgba(26,74,58,0.15);
  border:1px solid rgba(26,74,58,0.4);
  border-radius:6px;
  padding:12px 10px;
  text-align:center;
  cursor:pointer;
  transition:all 0.2s;
}

.vc-card:hover,
.vc-card.playing {
  border-color:#4a9e42;
}

.vc-ar {
  font-family:'Amiri',serif;
  font-size:1.5rem;
  color:#7dd874;
  direction:rtl;
  display:block;
  margin-bottom:5px;
}

.vc-fr {
  font-size:0.78rem;
  color:rgba(253,246,227,0.6);
}

.vc-root {
  font-size:0.68rem;
  color:rgba(125,216,116,0.5);
  margin-top:2px;
  font-style:italic;
}

.toast {
  position:fixed;
  bottom:24px;
  left:50%;
  transform:translateX(-50%);
  background:rgba(201,168,76,0.95);
  color:var(--dark);
  padding:8px 20px;
  border-radius:20px;
  font-size:0.82rem;
  font-weight:700;
  opacity:0;
  transition:opacity 0.3s;
  pointer-events:none;
  z-index:200;
  white-space:nowrap;
}

.toast.show {
  opacity:1;
}

@media(max-width:600px) {
  .hdr-ar {
    font-size:2rem;
  }

  .hdr-fr {
    font-size:0.68rem;
    letter-spacing:0.12em;
  }

  .vocab-grid {
    grid-template-columns:repeat(2,1fr);
  }

  .q-opts {
    grid-template-columns:1fr;
  }

  .quiz-box {
    padding:28px 16px;
  }

  .verse-ar {
    font-size:1.45rem;
  }

  .fc-ar {
    font-size:2.8rem;
  }
}
</style>
</head>

<body>

<div class="wrap">

<header>
  <div class="hdr-ar">أَوَّلُ كَلِمَاتِي — فَهْمُ الْقُرْآن</div>
  <div class="hdr-fr">Mes Premiers Mots en Arabe · Comprendre le Coran</div>
</header>

<nav class="nav">
  <button class="nav-btn active" onclick="showSec('fiches',this)">📚 Fiches</button>
  <button class="nav-btn" onclick="showSec('flashcards',this)">🃏 Flashcards</button>
  <button class="nav-btn" onclick="showSec('quiz',this)">🎯 Quiz</button>
  <button class="nav-btn" onclick="showSec('coran',this)">📖 Coran</button>
</nav>

<div id="fiches" class="section active">
  <div class="cats" id="fiche-cats"></div>
  <div id="fiche-content"></div>
</div>

<div id="flashcards" class="section">

  <div class="sec-title">Flashcards</div>

  <div class="cats" id="flash-cats"></div>

  <div class="tip">
    💡 Touchez la carte pour la retourner. Appuyez sur 🔊 pour écouter.
  </div>

  <div class="fc-wrap" onclick="flipCard()">
    <div class="flashcard" id="flashcard">

      <div class="fc-face fc-front">
        <div class="fc-lbl">Mot arabe — traduisez</div>
        <div class="fc-ar" id="fc-arabic"></div>
        <div class="fc-hint">touchez pour retourner</div>
      </div>

      <div class="fc-face fc-back">
        <div class="fc-lbl">Traduction française</div>
        <div class="fc-fr" id="fc-french"></div>
        <div class="fc-hint" id="fc-tr" style="color:rgba(201,168,76,0.5)"></div>
      </div>

    </div>
  </div>

  <div class="fc-nav">
    <button class="btn-ol" onclick="prevCard()">←</button>

    <button
      class="fc-speak"
      id="fc-speak-btn"
      onclick="event.stopPropagation(); speakCurrentFlashcard(this)"
    >
      🔊
    </button>

    <div class="fc-cnt" id="fc-counter">1/1</div>

    <button class="btn-ol" onclick="nextCard()">→</button>
  </div>

</div>

<div id="quiz" class="section">

  <div class="sec-title">Quiz</div>

  <div class="cats" id="quiz-cats"></div>

  <div class="quiz-box">

    <div class="q-score">
      Score :
      <span class="q-num" id="q-score">0</span>
      /
      <span id="q-total">0</span>
    </div>

    <div
      class="q-word"
      id="q-word"
      onclick="speakTTS(this.textContent,this)"
    ></div>

    <div class="q-hint">
      🔊 Touchez le mot pour l'écouter
    </div>

    <div class="q-opts" id="q-opts"></div>

    <div class="q-fb" id="q-fb"></div>

    <button
      class="btn"
      id="q-next"
      onclick="nextQuestion()"
      style="display:none"
    >
      Question suivante →
    </button>

  </div>

</div>

<div id="coran" class="section">

  <div class="sec-title">
