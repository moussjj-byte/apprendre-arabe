function buildPills(id, active, fn, data) {

  const el = document.getElementById(id);

  el.innerHTML = '';

  Object.entries(data).forEach(([key,value]) => {

    const button = document.createElement('button');

    button.className =
      'cat-pill' +
      (key === active ? ' active' : '');

    button.textContent = value.label;

    button.onclick = function() {

      el.querySelectorAll('.cat-pill')
        .forEach(x => x.classList.remove('active'));

      button.classList.add('active');

      fn(key);
    };

    el.appendChild(button);
  });
}


function renderFiches(cat) {

  const content = document.getElementById('fiche-content');

  content.innerHTML =
    `<div class="sec-title">${VOCAB[cat].label}</div>
     <div class="vocab-grid">

     ${VOCAB[cat].items.map(item => {

       const ar = item.ar
         .replace(/\\/g,'\\\\')
         .replace(/'/g,"\\'");

       return `
         <div
           class="v-card"
           onclick="speakTTS('${ar}',this)"
         >

           <span class="v-ar">${item.ar}</span>

           <div class="v-fr">
             ${item.fr}
           </div>

           <div class="v-tr">
             ${item.tr}
           </div>

           <button
             class="speak-btn"
             onclick="event.stopPropagation();speakTTS('${ar}',this)"
           >
             🔊 Écouter
           </button>

         </div>
       `;

     }).join('')}

     </div>`;
}


