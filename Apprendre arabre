/* ══════════════════════════════════════════════
   AUDIO ENGINE
   ══════════════════════════════════════════════ */

const AUDIO = new Audio();
AUDIO.preload = 'auto';

let currentSpeakEl = null;
let currentAudioType = null;


/* ──────────────────────────────────────────────
   INDICATEUR "EN LECTURE"
   ────────────────────────────────────────────── */

function setPlaying(el, playing) {

  if (currentSpeakEl && currentSpeakEl !== el) {
    currentSpeakEl.classList.remove('playing');
  }

  if (el) {
    el.classList.toggle('playing', playing);
    currentSpeakEl = playing ? el : null;
  } else {
    currentSpeakEl = null;
  }
}


/* ──────────────────────────────────────────────
   ARRÊTER TOUS LES SONS
   ────────────────────────────────────────────── */

function stopAllAudio() {

  AUDIO.pause();
  AUDIO.currentTime = 0;

  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
  }

  setPlaying(null, false);

  document.querySelectorAll('.audio-play').forEach(btn => {
    btn.textContent = '▶';
  });

  document.querySelectorAll('.audio-fill').forEach(fill => {
    fill.style.width = '0%';
  });

  currentAudioType = null;
}


/* ──────────────────────────────────────────────
   VOIX ARABE
   ────────────────────────────────────────────── */

function getArabicVoice() {

  if (!('speechSynthesis' in window)) {
    return null;
  }

  const voices = window.speechSynthesis.getVoices();

  return (
    voices.find(v => v.lang === 'ar-SA') ||
    voices.find(v => v.lang === 'ar') ||
    voices.find(v => v.lang && v.lang.toLowerCase().startsWith('ar'))
  );
}


/* ──────────────────────────────────────────────
   LECTURE DES MOTS ARABES
   ────────────────────────────────────────────── */

function speakTTS(text, el) {

  if (!text || !text.trim()) {
    return;
  }

  if (!('speechSynthesis' in window)) {
    toast('La synthèse vocale n’est pas disponible');
    return;
  }

  AUDIO.pause();

  window.speechSynthesis.cancel();

  setPlaying(null, false);

  if (el) {
    setPlaying(el, true);
  }

  currentAudioType = 'tts';

  const utterance = new SpeechSynthesisUtterance(text.trim());

  utterance.lang = 'ar-SA';
  utterance.rate = 0.72;
  utterance.pitch = 1;
  utterance.volume = 1;

  const voice = getArabicVoice();

  if (voice) {
    utterance.voice = voice;
  }

  utterance.onend = function() {
    setPlaying(el, false);
    currentAudioType = null;
  };

  utterance.onerror = function() {
    setPlaying(el, false);
    currentAudioType = null;
    toast('Impossible de lire ce mot');
  };

  window.speechSynthesis.speak(utterance);
}


/* ──────────────────────────────────────────────
   CHARGEMENT DES VOIX IOS
   ────────────────────────────────────────────── */

if ('speechSynthesis' in window) {

  window.speechSynthesis.getVoices();

  window.speechSynthesis.onvoiceschanged = function() {
    window.speechSynthesis.getVoices();
  };
}


/* ──────────────────────────────────────────────
   LECTURE D'UN FICHIER AUDIO
   ────────────────────────────────────────────── */

function playUrl(url, el) {

  if (!url) {
    toast('Audio indisponible');
    return;
  }

  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
  }

  AUDIO.pause();

  setPlaying(null, false);

  AUDIO.src = url;
  AUDIO.currentTime = 0;
  AUDIO.preload = 'auto';

  if (el) {
    setPlaying(el, true);
  }

  currentAudioType = 'file';

  AUDIO.onended = function() {
    setPlaying(el, false);
    currentAudioType = null;
  };

  AUDIO.onerror = function() {
    setPlaying(el, false);
    currentAudioType = null;
    toast('Audio indisponible');
  };

  const promise = AUDIO.play();

  if (promise) {

    promise.catch(function() {

      setPlaying(el, false);
      currentAudioType = null;

      toast('Touchez à nouveau pour lancer le son');

    });

  }
}


/* ──────────────────────────────────────────────
   AUDIO DES VERSETS DU CORAN
   ──────────────────────────────────────────────

   On utilise l'API AlQuran Cloud pour récupérer
   directement la bonne URL audio de l'ayah.

   Cela évite l'ancien problème où l'URL était
   construite avec "surate + numéro du verset".
   ────────────────────────────────────────────── */

async function playVerse(surahNum, verseNum, el) {

  stopAllAudio();

  setPlaying(el, true);

  currentAudioType = 'verse';

  try {

    const apiUrl =
      `https://api.alquran.cloud/v1/ayah/${surahNum}:${verseNum}/ar.alafasy`;

    const response = await fetch(apiUrl);

    if (!response.ok) {
      throw new Error('API error');
    }

    const json = await response.json();

    const audioUrl = json &&
                     json.data &&
                     json.data.audio;

    if (!audioUrl) {
      throw new Error('No audio');
    }

    AUDIO.src = audioUrl;
    AUDIO.currentTime = 0;
    AUDIO.preload = 'auto';

    AUDIO.onended = function() {
      setPlaying(el, false);
      currentAudioType = null;
    };

    AUDIO.onerror = function() {
      setPlaying(el, false);
      currentAudioType = null;
      fallbackVerseTTS(surahNum, verseNum, el);
    };

    await AUDIO.play();

  } catch (error) {

    setPlaying(el, false);

    fallbackVerseTTS(surahNum, verseNum, el);
  }
}


/* ──────────────────────────────────────────────
   SECOURS SI L'AUDIO DU VERSET NE CHARGE PAS
   ────────────────────────────────────────────── */

function fallbackVerseTTS(surahNum, verseNum, el) {

  let verseText = '';

  const surah = SOURATES.find(s => s.num === surahNum);

  if (surah) {

    const verse = surah.verses.find(v => v.num === verseNum);

    if (verse) {
      verseText = verse.ar;
    }
  }

  if (verseText) {

    speakTTS(verseText, el);

  } else {

    toast('Audio du verset indisponible');
  }
}


/* ──────────────────────────────────────────────
   AUDIO COMPLET DES SOURATES
   ────────────────────────────────────────────── */

