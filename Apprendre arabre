/* ──────────────────────────────────────────────
   SOURATE COMPLÈTE
   ────────────────────────────────────────────── */

function toggleSurahAudio(surahNum, btnEl) {

  const url = SURAH_AUDIO[surahNum];

  if (!url) {
    toast('Audio de cette sourate indisponible');
    return;
  }

  if (
    !AUDIO.paused &&
    AUDIO.dataset.surah === String(surahNum)
  ) {

    AUDIO.pause();

    btnEl.textContent = '▶';

    return;
  }

  stopAllAudio();

  AUDIO.src = url;
  AUDIO.currentTime = 0;
  AUDIO.dataset.surah = String(surahNum);
  AUDIO.preload = 'auto';

  const audioBar = btnEl.closest('.audio-bar');

  const fillEl = audioBar
    ? audioBar.querySelector('.audio-fill')
    : null;

  AUDIO.ontimeupdate = function() {

    if (
      fillEl &&
      AUDIO.duration &&
      isFinite(AUDIO.duration)
    ) {

      const percentage =
        (AUDIO.currentTime / AUDIO.duration) * 100;

      fillEl.style.width = percentage + '%';
    }
  };

  AUDIO.onended = function() {

    btnEl.textContent = '▶';

    if (fillEl) {
      fillEl.style.width = '0%';
    }

    currentAudioType = null;
  };

  AUDIO.onerror = function() {

    btnEl.textContent = '▶';

    if (fillEl) {
      fillEl.style.width = '0%';
    }

    currentAudioType = null;

    toast('Audio de la sourate indisponible');
  };

  btnEl.textContent = '⏸';

  currentAudioType = 'surah';

  const promise = AUDIO.play();

  if (promise) {

    promise.catch(function() {

      btnEl.textContent = '▶';

      toast('Touchez ▶ à nouveau pour lancer la récitation');

    });

  }
}


/* ──────────────────────────────────────────────
   TOAST
   ────────────────────────────────────────────── */

function toast(msg) {

  const el = document.getElementById('toast');

  if (!el) {
    return;
  }

  el.textContent = msg;

  el.classList.add('show');

  clearTimeout(window.toastTimer);

  window.toastTimer = setTimeout(function() {

    el.classList.remove('show');

  }, 2500);
}


