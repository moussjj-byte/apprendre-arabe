let fcItems = [];
let fcIdx = 0;
let fcFlipped = false;


function initFlash(cat) {

  fcItems = [...VOCAB[cat].items]
    .sort(() => Math.random() - 0.5);

  fcIdx = 0;

  fcFlipped = false;

  showCard();
}


function showCard() {

  document
    .getElementById('flashcard')
    .classList.remove('flipped');

  fcFlipped = false;

  const item = fcItems[fcIdx];

  document.getElementById('fc-arabic').textContent =
    item.ar;

  document.getElementById('fc-french').textContent =
    item.fr;

  document.getElementById('fc-tr').textContent =
    item.tr;

  document.getElementById('fc-counter').textContent =
    `${fcIdx + 1}/${fcItems.length}`;

  const button =
    document.getElementById('fc-speak-btn');

  if (button) {
    button.classList.remove('playing');
  }
}


function flipCard() {

  fcFlipped = !fcFlipped;

  document
    .getElementById('flashcard')
    .classList.toggle(
      'flipped',
      fcFlipped
    );
}


function speakCurrentFlashcard(button) {

  const text =
    document.getElementById('fc-arabic').textContent;

  speakTTS(text, button);
}


function nextCard() {

  fcIdx =
    (fcIdx + 1) % fcItems.length;

  showCard();
}


function prevCard() {

  fcIdx =
    (fcIdx - 1 + fcItems.length) %
    fcItems.length;

  showCard();
}


buildPills(
  'flash-cats',
  'couleurs',
  initFlash,
  VOCAB
);

initFlash('couleurs');


/* ══════════════════════════════════════════════
   QUIZ
   ══════════════════════════════════════════════ */

let qCat = 'couleurs';
let qItems = [];
let qScore = 0;
let qTotal = 0;
let qAnswered = false;
let qCurrent = null;


function initQuiz(cat) {

  qCat = cat;

  qScore = 0;
  qTotal = 0;

  qItems = [...VOCAB[cat].items]
    .sort(() => Math.random() - 0.5);

  document.getElementById('q-score').textContent = 0;
  document.getElementById('q-total').textContent = 0;

  document.getElementById('q-fb').textContent = '';

  nextQuestion();
}


function nextQuestion() {

  if (!qItems.length) {

    qItems = [...VOCAB[qCat].items]
      .sort(() => Math.random() - 0.5);
  }

  qCurrent = qItems.pop();

  qAnswered = false;

  document.getElementById('q-word').textContent =
    qCurrent.ar;

  document.getElementById('q-fb').textContent = '';

  document.getElementById('q-fb').className =
    'q-fb';

  document.getElementById('q-next').style.display =
    'none';

  const all = VOCAB[qCat].items;

  const opts = [
    qCurrent,

    ...all
      .filter(item => item.ar !== qCurrent.ar)
      .sort(() => Math.random() - 0.5)
      .slice(0,3)

  ].sort(() => Math.random() - 0.5);

  document.getElementById('q-opts').innerHTML =
    opts.map(option => {

      const chosen =
        option.fr.replace(/'/g,"\\'");

      const correct =
        qCurrent.fr.replace(/'/g,"\\'");

      return `
        <button
          class="q-opt"
          onclick="answerQ(
            this,
            '${chosen}',
            '${correct}'
          )"
        >
          ${option.fr}
        </button>
      `;

    }).join('');
}


function answerQ(btn, chosen, correct) {

  if (qAnswered) {
    return;
  }

  qAnswered = true;

  qTotal++;

  document.getElementById('q-total').textContent =
    qTotal;

  document
    .querySelectorAll('.q-opt')
    .forEach(button => {

      button.disabled = true;

      if (button.textContent.trim() === correct) {
        button.classList.add('correct');
      }
    });

  const feedback =
    document.getElementById('q-fb');

  if (chosen === correct) {

    qScore++;

    btn.classList.add('correct');

    feedback.textContent =
      '✓ Excellent !';

    feedback.className =
      'q-fb ok';

  } else {

    btn.classList.add('wrong');

    feedback.textContent =
      `✗ C'était : ${correct}`;

    feedback.className =
      'q-fb err';
  }

  document.getElementById('q-score').textContent =
    qScore;

  document.getElementById('q-next').style.display =
    'inline-block';
}


buildPills(
  'quiz-cats',
  'couleurs',
  initQuiz,
  VOCAB
);

initQuiz('couleurs');


